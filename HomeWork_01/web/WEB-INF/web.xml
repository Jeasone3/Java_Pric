<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>简单备忘录</display-name>

    <!-- 统一设置 UTF-8，并检查备忘录请求的登录状态。 -->
    <filter>
        <filter-name>LoginFilter</filter-name>
        <filter-class>com.example.memo.filter.LoginFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>LoginFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 每个功能对应一个 Servlet，访问路径统一在这里配置。 -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.example.memo.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.example.memo.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MemoListServlet</servlet-name>
        <servlet-class>com.example.memo.servlet.MemoListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MemoListServlet</servlet-name>
        <url-pattern>/memo/list</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MemoAddServlet</servlet-name>
        <servlet-class>com.example.memo.servlet.MemoAddServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MemoAddServlet</servlet-name>
        <url-pattern>/memo/add</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MemoDetailServlet</servlet-name>
        <servlet-class>com.example.memo.servlet.MemoDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MemoDetailServlet</servlet-name>
        <url-pattern>/memo/detail</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MemoUpdateServlet</servlet-name>
        <servlet-class>com.example.memo.servlet.MemoUpdateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MemoUpdateServlet</servlet-name>
        <url-pattern>/memo/update</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MemoDeleteServlet</servlet-name>
        <servlet-class>com.example.memo.servlet.MemoDeleteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MemoDeleteServlet</servlet-name>
        <url-pattern>/memo/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RecycleBinServlet</servlet-name>
        <servlet-class>com.example.memo.servlet.RecycleBinServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RecycleBinServlet</servlet-name>
        <url-pattern>/memo/recycle</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MemoRestoreServlet</servlet-name>
        <servlet-class>com.example.memo.servlet.MemoRestoreServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MemoRestoreServlet</servlet-name>
        <url-pattern>/memo/restore</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MemoRemoveServlet</servlet-name>
        <servlet-class>com.example.memo.servlet.MemoRemoveServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MemoRemoveServlet</servlet-name>
        <url-pattern>/memo/remove</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>

</web-app>
